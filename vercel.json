{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/exchange-program.html", "destination": "/", "permanent": true },
    { "source": "/usa", "destination": "/country/united-states/", "permanent": true },
    { "source": "/usa/", "destination": "/country/united-states/", "permanent": true },
    { "source": "/us", "destination": "/country/united-states/", "permanent": true },
    { "source": "/us/", "destination": "/country/united-states/", "permanent": true },
    { "source": "/united-states", "destination": "/country/united-states/", "permanent": true },
    { "source": "/united-states/", "destination": "/country/united-states/", "permanent": true },
    { "source": "/uk", "destination": "/country/united-kingdom/", "permanent": true },
    { "source": "/uk/", "destination": "/country/united-kingdom/", "permanent": true },
    { "source": "/united-kingdom", "destination": "/country/united-kingdom/", "permanent": true },
    { "source": "/united-kingdom/", "destination": "/country/united-kingdom/", "permanent": true },
    { "source": "/opportunity/:slug/index.html", "destination": "/opportunity/:slug/", "permanent": true },
    { "source": "/country/:slug/index.html", "destination": "/country/:slug/", "permanent": true },
    { "source": "/scholarships/:slug/index.html", "destination": "/scholarships/:slug/", "permanent": true },
    { "source": "/internships/:slug/index.html", "destination": "/internships/:slug/", "permanent": true },
    { "source": "/fellowships/:slug/index.html", "destination": "/fellowships/:slug/", "permanent": true },
    { "source": "/competitions/:slug/index.html", "destination": "/competitions/:slug/", "permanent": true },
    {
      "source": "/ads.txt",
      "has": [{ "type": "host", "value": "opportunitynest.org" }],
      "destination": "https://www.opportunitynest.org/ads.txt",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "opportunitynest.org" }],
      "destination": "https://www.opportunitynest.org/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/opportunity/:slug/", "destination": "/opportunity-detail.html" },
    { "source": "/opportunity/:slug", "destination": "/opportunity-detail.html" },
    { "source": "/competitions/", "destination": "/competitions.html" },
    { "source": "/about/", "destination": "/about.html" },
    { "source": "/contact/", "destination": "/contact.html" },
    { "source": "/faq/", "destination": "/faq.html" },
    { "source": "/privacy/", "destination": "/privacy.html" },
    { "source": "/privacy-policy/", "destination": "/privacy.html" },
    { "source": "/terms/", "destination": "/terms.html" },
    { "source": "/terms-conditions/", "destination": "/terms.html" },
    { "source": "/disclaimer/", "destination": "/disclaimer.html" },
    { "source": "/editorial-policy/", "destination": "/editorial-policy.html" },
    { "source": "/fact-checking-policy/", "destination": "/fact-checking-policy.html" },
    { "source": "/verification-process/", "destination": "/verification-process.html" },
    { "source": "/thank-you/", "destination": "/thank-you.html" },
    { "source": "/cookie-policy/", "destination": "/privacy.html" },
    { "source": "/nav-dropdown-backup/", "destination": "/nav-dropdown-backup.html" },
    { "source": "/blog/:slug/", "destination": "/blog/:slug.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" },
    { "source": "/guides/:slug/", "destination": "/guides/:slug.html" },
    { "source": "/guides/:slug", "destination": "/guides/:slug.html" },
    { "source": "/404/", "destination": "/404.html" },
    { "source": "/404", "destination": "/404.html" }
  ],
  "headers": [
    {
      "source": "/:path*.(css|js|svg|png|jpg|jpeg|webp|avif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Link", "value": "<https://pagead2.googlesyndication.com>; rel=dns-prefetch, <https://www.googletagmanager.com>; rel=dns-prefetch, <https://www.google-analytics.com>; rel=dns-prefetch, <https://rveunrzbeynaizitqanx.supabase.co>; rel=dns-prefetch, <https://chatling.ai>; rel=dns-prefetch" }
      ]
    },
    {
      "source": "/:path*.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/ads.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300, must-revalidate" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/data/:path*.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), display-capture=(), usb=(), serial=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), bluetooth=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://opportunitynest.org https://*.opportunitynest.org; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://pagead2.googlesyndication.com https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://*.doubleclick.net https://cdn.jsdelivr.net https://chatling.ai https://*.chatling.ai https:; script-src-elem 'self' 'unsafe-inline' https://pagead2.googlesyndication.com https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://*.doubleclick.net https://cdn.jsdelivr.net https://chatling.ai https://*.chatling.ai https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://rveunrzbeynaizitqanx.supabase.co https://*.supabase.co https://*.supabase.com https://formsubmit.co https://formspree.io https://*.google-analytics.com https://*.googlesyndication.com https://*.doubleclick.net https://*.gstatic.com https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://googleads.g.doubleclick.net https://www.googletagmanager.com https://www.google-analytics.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://chatling.ai https://*.chatling.ai https:; worker-src 'self' https://quge5.com https://aqu5es.com https://3nbf4.com https://6opo.com https://uaugot.com https://ekhay.com https://b3mny.com https://auqot.com https://monetag.com https://*.monetag.com; frame-src 'self' https://*.google.com https://*.googlesyndication.com https://*.doubleclick.net https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://pagead2.googlesyndication.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://chatling.ai https://*.chatling.ai; form-action 'self' https://formsubmit.co https://formspree.io; manifest-src 'self';"
        }
      ]
    }
  ]
}
